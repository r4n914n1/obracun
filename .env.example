VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_HERE_API_KEY=your_here_api_key
# Root domen: https://transportcost.info/
VITE_BASE=/
VITE_APP_URL=https://transportcost.info/

# Firebase (Google login + čuvanje popusta po nalogu u Firestore)
# U Firebase Console → Authentication → Authorized domains: transportcost.info
# Za bug report e-mail: firebase functions:secrets:set RESEND_API_KEY
# (Resend + verifikovan domen transportcost.info za MAIL_FROM)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PayPal (Firebase Functions params — ne idu u .env.local frontend)
# firebase functions:secrets:set PAYPAL_CLIENT_ID
# firebase functions:secrets:set PAYPAL_CLIENT_SECRET
# firebase functions:secrets:set PAYPAL_WEBHOOK_ID
# firebase functions:config:set (ili params) za PayPal Plan ID svakog paketa:
# PAYPAL_PLAN_STARTER_1M, PAYPAL_PLAN_STANDARD_1M, PAYPAL_PLAN_PRO_1M
# PAYPAL_PLAN_STARTER_3M, PAYPAL_PLAN_STANDARD_3M, PAYPAL_PLAN_PRO_3M
# PAYPAL_MODE=sandbox|live, APP_URL=https://transportcost.info/
# Webhook URL: https://us-central1-transportcost.cloudfunctions.net/paypalWebhook
